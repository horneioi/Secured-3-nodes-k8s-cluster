apiVersion: v1
kind: Service
metadata:
  name: vmsingle-nodeport
  namespace: {{ victoria_metrics_namespace }}
spec:
  type: NodePort
  selector:
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/instance: vmks-victoria-metrics-k8s-stack
    app.kubernetes.io/name: vmsingle
    managed-by: vm-operator
  ports:
    - name: http
      port: 8428
      targetPort: 8428
      nodePort: 32001
      protocol: TCP