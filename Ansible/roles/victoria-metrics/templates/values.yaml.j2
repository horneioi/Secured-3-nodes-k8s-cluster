---
victoria-metrics-operator:
  enabled: {{ victoria_metrics_operator_enabled | lower }}

vmagent:
  enabled: true
  spec:
    scrapeInterval: 30s

vmalert:
  enabled: false

alertmanager:
  enabled: false

grafana:
  enabled: {{ victoria_metrics_grafana_enabled | lower }}
  service:
    type: NodePort
    port: 80
    targetPort: 3000
    nodePort: 32000

vmsingle:
  enabled: true
  spec:
    retentionPeriod: "{{ victoria_metrics_retention_period }}"
    replicaCount: 1
    storage:
      accessModes:
        - ReadWriteOnce
      resources:
        requests:
          storage: 20Gi
      storageClassName: ""
  service:
    type: NodePort
    servicePort: 8428
    nodePort: 32001