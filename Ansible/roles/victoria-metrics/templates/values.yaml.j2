---
victoria-metrics-operator:
  enabled: {{ victoria_metrics_operator_enabled | lower }}

vmagent:
  enabled: true
  spec:
    scrapeInterval: 30s

vmalert:
  enabled: true

alertmanager:
  enabled: true
  spec:
    configSecret: alertmanager-telegram-config
    extraEnvs:
      - name: HTTP_PROXY
        value: "{{ lookup('env', 'PROXY_HTTP_URL') }}"
      - name: HTTPS_PROXY
        value: "{{ lookup('env', 'PROXY_HTTP_URL') }}"
      - name: http_proxy
        value: "{{ lookup('env', 'PROXY_HTTP_URL') }}"
      - name: https_proxy
        value: "{{ lookup('env', 'PROXY_HTTP_URL') }}"
      - name: NO_PROXY
        value: "{{ no_proxy }}"
      - name: no_proxy
        value: "{{ no_proxy }}"

grafana:
  enabled: {{ victoria_metrics_grafana_enabled | lower }}
  service:
    type: NodePort
    port: 80
    targetPort: 3000
    nodePort: 32000

vmsingle:
  enabled: true
  spec:
    retentionPeriod: "{{ victoria_metrics_retention_period }}"
    replicaCount: 1
    storage:
      accessModes:
        - ReadWriteOnce
      resources:
        requests:
          storage: 20Gi
      storageClassName: ""
  service:
    type: NodePort
    servicePort: 8428
    nodePort: 32001

