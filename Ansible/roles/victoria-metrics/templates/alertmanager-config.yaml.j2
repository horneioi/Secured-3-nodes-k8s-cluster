apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-telegram-config
  namespace: {{ victoria_metrics_namespace }}
  labels:
    app: vm-operator
type: Opaque
stringData:
  alertmanager.yaml: |
    global:
      resolve_timeout: 5m

    route:
      receiver: telegram
      group_by:
        - alertname
        - namespace
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h

    receivers:
      - name: telegram
        telegram_configs:
          - bot_token: "{{ lookup('env', 'TG_BOT_TOKEN') }}"
            chat_id: {{ lookup('env', 'TG_CHAT_ID') }}
            send_resolved: true
            parse_mode: HTML
            http_config:
              proxy_url: "{{ lookup('env', 'PROXY_HTTP_URL') }}"